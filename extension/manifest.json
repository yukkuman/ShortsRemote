{
  "manifest_version": 3,
  "name": "ShortUp — Shorts Remote",
  "version": "0.1.0",
  "key": "",
  "description": "ゲームをしたまま、グローバルショートカットで YouTube ショートを「次へ / 前へ」送る。",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "ShortUp",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "shorts-next": {
      "suggested_key": { "default": "Ctrl+Shift+2" },
      "description": "次のショートへ",
      "global": true
    },
    "shorts-prev": {
      "suggested_key": { "default": "Ctrl+Shift+1" },
      "description": "前のショートへ",
      "global": true
    },
    "shorts-toggle": {
      "suggested_key": { "default": "Ctrl+Shift+3" },
      "description": "再生 / 一時停止",
      "global": true
    },
    "shorts-like": {
      "suggested_key": { "default": "Ctrl+Shift+4" },
      "description": "高評価",
      "global": true
    },
    "shorts-mute": {
      "description": "ミュート切替（既定キーなし／chrome://extensions/shortcuts で割当）",
      "global": true
    }
  }
}
